<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window id="1114">
    <onload>RunScript(special://skin/extras/stremio_dispatch.py,library_filters.py,default)</onload>
    <defaultcontrol always="true">77777</defaultcontrol>
    <menucontrol>900</menucontrol>
    <include>CustomBingieWinProps</include>
    <include>BingieViews_WindowOpen_Fade</include>
	<onload>Skin.TimerStart(spotlightanimation)</onload>
    <controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
        <!-- fake go-to-fullscreen button -->
        <control type="button" id="509">
            <visible allowhiddenfocus="true">false</visible>
            <onfocus>FullScreen</onfocus>
        </control>
        <include>GlobalBackground</include>

        <!-- hidden submenu for count calculations -->
        <include condition="!Skin.HasSetting(DisableAllSubmenus)">hiddenSubmenu</include>
        <include>HomeBingie</include>
        <!-- The original My List panel has no widget header. Keep its geometry,
             but restore a Library row title independently of card-name settings. -->
        <control type="group">
            <include condition="Skin.HasSetting(StremioView)">StremioHomeRowPosition</include>
            <include condition="!Skin.HasSetting(StremioView)">OriginalBingieHomeRowPosition</include>
            <control type="label">
                <left>139</left><top>-12</top><width>1500</width><height>42</height>
                <font>Bold31</font>
                <textcolor>$INFO[Skin.String(BingieHeaderTextColor)]</textcolor>
                <label>My Library</label>
                <visible>Integer.IsGreater(Container(1520).NumItems,0) | Container(1520).IsUpdating</visible>
            </control>
        </control>
		<control type="label">
            <visible>Integer.IsEqual(Container(1520).NumItems,0) + !Container(1520).IsUpdating</visible>
			<left>139</left>
			<top>564</top>
            <height>80</height>
            <width>99%</width>
            <font>Bold31</font>
            <textcolor>$INFO[Skin.String(ViewDetailsTextColor)]</textcolor>
            <focusedcolor>$INFO[Skin.String(ViewDetailsTextColor)]</focusedcolor>
            <label>My Library is empty</label>
        </control>
		<!-- Loading Spinner -->
        <include content="Busy_Spinner">
            <param name="centerleft" value="50%"/>
            <param name="centertop" value="50%"/>
            <param name="visibility" value="Container(1520).IsUpdating + !Integer.IsGreater(Container(1520).NumItems,0)"/>
            <param name="size" value="100"/>
        </include>
        <include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
    </controls>
</window>
