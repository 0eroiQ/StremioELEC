        <value condition="String.IsEqual(Window.Property(AdditionalInfo),cast) + [String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)] + !String.IsEmpty(ListItem.UniqueID(imdb))">plugin://plugin.video.stremioelec/?action=details_cast&amp;kind=series&amp;id=$INFO[ListItem.UniqueID(imdb)]</value>
