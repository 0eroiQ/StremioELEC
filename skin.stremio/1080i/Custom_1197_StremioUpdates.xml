<?xml version="1.0" encoding="utf-8"?>
<window id="1197">
  <defaultcontrol always="true">200</defaultcontrol>
  <onload>RunScript(special://xbmc/addons/service.stremioelec.updates/ui.py,refresh)</onload>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF080808">white.png</texture>
    </control>

    <control type="label">
      <left>150</left><top>65</top><width>1550</width><height>70</height>
      <font>Bold40</font><label>System Updates</label><textcolor>white</textcolor>
    </control>
    <control type="label">
      <left>150</left><top>130</top><width>1550</width><height>45</height>
      <font>Reg24</font>
      <label>StremioELEC system and interface updates. Verified packages only.</label>
      <textcolor>grey</textcolor>
    </control>

    <control type="group">
      <left>150</left><top>205</top><width>1560</width><height>160</height>
      <control type="image">
        <width>1560</width><height>160</height>
        <texture border="15" colordiffuse="FF171717">diffuse/bgpanel.png</texture>
      </control>
      <control type="label">
        <left>35</left><top>22</top><width>650</width><height>42</height>
        <font>Reg28</font><label>Current version</label><textcolor>grey</textcolor>
      </control>
      <control type="label">
        <left>760</left><top>22</top><width>745</width><height>42</height>
        <font>Reg28</font><align>right</align>
        <label>$INFO[Window.Property(StremioUpdate.Version)]</label><textcolor>white</textcolor>
      </control>
      <control type="label">
        <left>35</left><top>84</top><width>650</width><height>42</height>
        <font>Reg28</font><label>Update channel</label><textcolor>grey</textcolor>
      </control>
      <control type="label">
        <left>760</left><top>84</top><width>745</width><height>42</height>
        <font>Reg28</font><align>right</align>
        <label>$INFO[Window.Property(StremioUpdate.Channel)]</label><textcolor>white</textcolor>
      </control>
    </control>

    <control type="grouplist" id="100">
      <left>150</left><top>395</top><width>1560</width><height>420</height>
      <orientation>vertical</orientation><itemgap>10</itemgap>

      <control type="button" id="200">
        <width>1560</width><height>72</height><font>Reg28</font>
        <label>Automatic system downloads</label>
        <label2>$INFO[Window.Property(StremioUpdate.AutoSystem)]</label2>
        <align>left</align><aligny>center</aligny><textoffsetx>30</textoffsetx>
        <onclick>RunScript(special://xbmc/addons/service.stremioelec.updates/ui.py,toggle_os)</onclick>
        <texturefocus border="15">diffuse/bgpanel.png</texturefocus>
        <texturenofocus border="15" colordiffuse="FF202020">diffuse/bgpanel.png</texturenofocus>
      </control>

      <control type="button" id="201">
        <width>1560</width><height>72</height><font>Reg28</font>
        <label>Automatic interface downloads</label>
        <label2>$INFO[Window.Property(StremioUpdate.AutoInterface)]</label2>
        <align>left</align><aligny>center</aligny><textoffsetx>30</textoffsetx>
        <onclick>RunScript(special://xbmc/addons/service.stremioelec.updates/ui.py,toggle_addons)</onclick>
        <texturefocus border="15">diffuse/bgpanel.png</texturefocus>
        <texturenofocus border="15" colordiffuse="FF202020">diffuse/bgpanel.png</texturenofocus>
      </control>

      <control type="button" id="202">
        <width>1560</width><height>72</height><font>Reg28</font>
        <label>Check for updates</label>
        <label2>$INFO[Window.Property(StremioUpdate.LastCheck)]</label2>
        <align>left</align><aligny>center</aligny><textoffsetx>30</textoffsetx>
        <onclick>RunScript(special://xbmc/addons/service.stremioelec.updates/ui.py,check)</onclick>
        <texturefocus border="15">diffuse/bgpanel.png</texturefocus>
        <texturenofocus border="15" colordiffuse="FF202020">diffuse/bgpanel.png</texturenofocus>
      </control>

      <control type="button" id="203">
        <width>1560</width><height>72</height><font>Reg28</font>
        <label>Install downloaded update &amp; restart</label>
        <label2>$INFO[Window.Property(StremioUpdate.Ready)]</label2>
        <align>left</align><aligny>center</aligny><textoffsetx>30</textoffsetx>
        <onclick>RunScript(special://xbmc/addons/service.stremioelec.updates/ui.py,install)</onclick>
        <texturefocus border="15">diffuse/bgpanel.png</texturefocus>
        <texturenofocus border="15" colordiffuse="FF202020">diffuse/bgpanel.png</texturenofocus>
      </control>
    </control>

    <control type="label">
      <left>150</left><top>850</top><width>1560</width><height>45</height>
      <font>Reg22</font><textcolor>grey</textcolor>
      <label>Status: $INFO[Window.Property(StremioUpdate.Status)]</label>
    </control>
    <control type="textbox">
      <left>150</left><top>900</top><width>1560</width><height>95</height>
      <font>Reg20</font><textcolor>grey</textcolor>
      <label>System updates replace SYSTEM and KERNEL on restart. Your Stremio account, settings and other data under /storage are retained.</label>
    </control>
  </controls>
</window>
