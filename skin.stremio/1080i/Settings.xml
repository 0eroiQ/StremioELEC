<?xml version="1.0" encoding="utf-8"?>
<!-- StremioELEC top-level settings: product, OS, then native Kodi advanced settings. -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <include>DefaultSkinSettings</include>
  <onload condition="System.HasAlarm(preview_delay)">CancelAlarm(preview_delay,silent)</onload>
  <controls>
    <include>GlobalBackground</include>
    <include>NowPlayingBackground</include>
    <include>Header</include>
    <control type="group">
      <include>animation_window_open_close</include>
      <bottom>135</bottom><height>75%</height>
      <control type="image"><posx>60</posx><width>1800</width><texture border="15">diffuse/bgpanel.png</texture><colordiffuse>$INFO[Skin.String(GeneralPanelsColor)]</colordiffuse></control>
      <control type="image"><posx>60</posx><width>560</width><texture border="15">diffuse/bgpanel.png</texture><colordiffuse>$INFO[Skin.String(GeneralPanelsColor)]</colordiffuse></control>
      <control type="image"><posx>90</posx><posy>30</posy><width>500</width><height>300</height><texture background="true">$INFO[Container(9000).ListItem.ActualIcon]</texture><aspectratio>scale</aspectratio><fadetime>350</fadetime></control>
      <control type="textbox"><posx>90</posx><posy>351</posy><width>500</width><height>270</height><font>Reg30</font><align>left</align><label>$INFO[Container(9000).ListItem.Label2]</label></control>
      <control type="panel" id="9000">
        <right>69</right><top>22</top><height>780</height><width>1208</width><orientation>vertical</orientation><onup>9000</onup><ondown>9000</ondown><preloaditems>3</preloaditems>
        <itemlayout height="260" width="302"><control type="group"><width>288</width><height>246</height><include>SquarePosterPanelLayout</include><control type="textbox"><left>15</left><right>15</right><bottom>8</bottom><height>38</height><align>center</align><aligny>center</aligny><label>[UPPERCASE]$INFO[ListItem.label][/UPPERCASE]</label><font>settings</font><autoscroll>false</autoscroll><textcolor>white</textcolor></control></control></itemlayout>
        <focusedlayout height="260" width="302"><control type="group"><width>288</width><height>246</height><include>SquarePosterPanelLayoutFocus</include><control type="textbox"><left>15</left><right>15</right><bottom>8</bottom><height>38</height><align>center</align><aligny>center</aligny><label>[UPPERCASE]$INFO[ListItem.label][/UPPERCASE]</label><font>settings</font><autoscroll delay="2000" time="2000" repeat="2000">true</autoscroll><textcolor>white</textcolor></control></control></focusedlayout>
        <content>
          <item id="90"><label>StremioELEC</label><label2>Account, Home, catalogs, subtitles, weather and StremioELEC preferences.</label2><onclick>ActivateWindow(1198)</onclick><icon>special://skin/extras/media/backgrounds/settings_bingie.jpg</icon><thumb>addonskin.png</thumb></item>
          <item id="91"><label>System</label><label2>Network, Bluetooth, services, backups and StremioELEC system updates.</label2><onclick condition="System.HasAddon(service.libreelec.settings)">RunScript(special://xbmc/addons/service.libreelec.settings/default.py)</onclick><onclick condition="!System.HasAddon(service.libreelec.settings)">RunScript(special://skin/extras/stremio_dispatch.py,settings_ui.py,system)</onclick><icon>special://skin/extras/media/backgrounds/settings_system.jpg</icon><thumb>settings.png</thumb></item>
          <item id="92"><label>Kodi Settings</label><label2>Advanced native Kodi settings for player, media, services, interface and system.</label2><onclick>ActivateWindow(1199)</onclick><icon>special://skin/extras/media/backgrounds/settings_player_settings.jpg</icon><thumb>player.png</thumb></item>
        </content>
      </control>
    </control>
    <include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
  </controls>
</window>
