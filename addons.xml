<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="plugin.video.stremioelec" name="StremioELEC Core" version="0.9.0" provider-name="0eroiQ">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="script.module.qrcode" version="6.1.0+matrix.3" optional="true" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.subtitle.module" library="subtitle_service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Portable StremioELEC core for Kodi 21</summary>
    <description lang="en_GB">Stremio account, Community Addons, catalogs, streams, subtitles, weather and StremioELEC integration for an existing Kodi installation.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/0eroiQ/StremioELEC</source>
  </extension>
</addon><addon id="service.stremioelec.portable" name="StremioELEC for Kodi" version="0.3.0" provider-name="0eroiQ">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="plugin.video.stremioelec" version="0.9.0" />
    <import addon="skin.stremio" version="3.1.0" />
  </requires>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.python.script" library="control.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Turn an existing Kodi 21 installation into StremioELEC mode</summary>
    <description lang="en_GB">Installs the StremioELEC portable runtime and skin, remembers the previous skin, and provides a reversible StremioELEC mode. OS-level LibreELEC updates are not installed.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/0eroiQ/StremioELEC</source>
  </extension>
</addon><addon id="skin.stremio" version="3.1.0" name="StremioELEC" provider-name="0eroiQ, matke">
  <requires>
        <import version="5.17.0" addon="xbmc.gui" />
    </requires>
  <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
    <res aspect="16:9" default="true" folder="1080i" height="1080" width="1920" />
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Stremio-first TV interface for StremioELEC.</summary>
    <description lang="en_GB">StremioELEC owns account, addons, Home, discovery, library, subtitles and settings while Kodi remains the playback engine. Visual foundations derived from Bingie remain credited under their original licence.</description>
    <platform>all</platform>
    <license>GPL v2.0</license>
    <source>https://github.com/0eroiQ/StremioELEC</source>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon></addons>